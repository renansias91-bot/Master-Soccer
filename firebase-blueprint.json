{
  "entities": {
    "Atleta": {
      "title": "Atleta",
      "description": "Atleta de base do Master Soccer RJ",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nome": { "type": "string" },
        "nomeCompleto": { "type": "string" },
        "apelido": { "type": "string" },
        "documento": { "type": "string" },
        "rg": { "type": "string" },
        "cpf": { "type": "string" },
        "categoria": { "type": "string" },
        "posicao": { "type": "string" },
        "numeroCamisa": { "type": "number" },
        "dataNascimento": { "type": "string" },
        "pernaDominante": { "type": "string" },
        "altura": { "type": "number" },
        "peso": { "type": "number" },
        "nomeResponsavel": { "type": "string" },
        "telefoneResponsavel": { "type": "string" },
        "status": { "type": "string" },
        "dataCadastro": { "type": "string" },
        "fotoUrl": { "type": "string" }
      },
      "required": ["nome", "categoria", "posicao", "status"]
    },
    "Avaliacao": {
      "title": "Avaliacao",
      "description": "Avaliação pós-jogo do atleta com os 5 pilares fundamentais",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "atletaId": { "type": "string" },
        "nomeAtleta": { "type": "string" },
        "categoria": { "type": "string" },
        "dataJogo": { "type": "string" },
        "data": { "type": "string" },
        "nota": { "type": "number" },
        "notaGeral": { "type": "number" },
        "observacoes": { "type": "string" },
        "nomeProfessor": { "type": "string" },
        "avaliador": { "type": "string" },
        "adversario": { "type": "string" },
        "competicao": { "type": "string" },
        "minutosJogados": { "type": "number" },
        "minutos1Tempo": { "type": "number" },
        "minutos2Tempo": { "type": "number" },
        "titular": { "type": "boolean" },
        "posicaoJogo": { "type": "string" },
        "gols": { "type": "number" },
        "assistencias": { "type": "number" },
        "cartoesAmarelos": { "type": "number" },
        "cartaoVermelho": { "type": "boolean" },
        "jogoAgendaId": { "type": "string" },
        "resultado": { "type": "string" }
      },
      "required": ["atletaId", "categoria", "notaGeral", "observacoes"]
    },
    "Jogo": {
      "title": "Jogo",
      "description": "Jogos e agenda de partidas do clube",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "adversario": { "type": "string" },
        "dataJogo": { "type": "string" },
        "hora": { "type": "string" },
        "categoria": { "type": "string" },
        "local": { "type": "string" },
        "tipo": { "type": "string" },
        "placar": { "type": "string" },
        "realizado": { "type": "boolean" }
      },
      "required": ["adversario", "dataJogo", "categoria"]
    },
    "TesteFisico": {
      "title": "TesteFisico",
      "description": "Testes de velocidade, salto vertical, resistência e flexibilidade",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "atletaId": { "type": "string" },
        "data": { "type": "string" },
        "categoria": { "type": "string" },
        "velocidade30m": { "type": "number" },
        "saltoVertical": { "type": "number" },
        "resistenciaYoYo": { "type": "number" },
        "flexibilidadeBanco": { "type": "number" }
      },
      "required": ["atletaId", "data", "categoria"]
    },
    "CompeticaoFinanceira": {
      "title": "CompeticaoFinanceira",
      "description": "Competição com Taxa de Inscrição e Taxa de Jogo editáveis",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nome": { "type": "string" },
        "valor": { "type": "number" },
        "valorInscricao": { "type": "number" },
        "valorJogo": { "type": "number" },
        "tipo": { "type": "string" },
        "categoria": { "type": "string" }
      },
      "required": ["id", "nome"]
    },
    "RegistroFinanceiroAtleta": {
      "title": "RegistroFinanceiroAtleta",
      "description": "Controle financeiro individual do atleta com mensalidades, inscrições e taxas de jogo",
      "type": "object",
      "properties": {
        "atletaId": { "type": "string" },
        "valorMensalidadePadrao": { "type": "number" },
        "mensalidadesPagas": { "type": "array" },
        "inscricoes": { "type": "array" },
        "taxasJogo": { "type": "array" }
      },
      "required": ["atletaId"]
    }
  },
  "firestore": {
    "/athletes/{athleteId}": {
      "schema": "Atleta",
      "description": "Cadastro e fichas de atletas do clube (coleção athletes)"
    },
    "/atletas/{atletaId}": {
      "schema": "Atleta",
      "description": "Cadastro e fichas de atletas do clube (coleção atletas)"
    },
    "/avaliacoes/{avaliacaoId}": {
      "schema": "Avaliacao",
      "description": "Avaliações individuais pós-jogo registradas pelos professores"
    },
    "/jogos/{jogoId}": {
      "schema": "Jogo",
      "description": "Jogos da agenda do clube"
    },
    "/testes_fisicos/{testeId}": {
      "schema": "TesteFisico",
      "description": "Testes físicos periódicos dos atletas"
    },
    "/financeiro_competicoes/{compId}": {
      "schema": "CompeticaoFinanceira",
      "description": "Competições e taxas do clube com Taxa de Inscrição e Taxa de Jogo"
    },
    "/financeiro_atletas/{atletaId}": {
      "schema": "RegistroFinanceiroAtleta",
      "description": "Registros financeiros individuais por atleta"
    }
  }
}
