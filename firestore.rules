rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /athletes/{athleteId} {
      allow read, write: if true;
    }
    match /atletas/{atletaId} {
      allow read, write: if true;
    }
    match /avaliacoes/{avaliacaoId} {
      allow read, write: if true;
    }
    match /jogos/{jogoId} {
      allow read, write: if true;
    }
    match /testes_fisicos/{testeId} {
      allow read, write: if true;
    }
    match /financeiro_competicoes/{compId} {
      allow read, write: if true;
    }
    match /financeiro_atletas/{atletaId} {
      allow read, write: if true;
    }
    match /configuracoes/{docId} {
      allow read, write: if true;
    }
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
